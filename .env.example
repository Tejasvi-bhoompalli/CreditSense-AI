# CreditSense AI - environment template
#
# Copy to `.env` and adjust. Every variable here is OPTIONAL: the core
# application works with none of them set. Never commit a filled-in `.env`.

# ---------------------------------------------------------------------------
# Local storage
# ---------------------------------------------------------------------------
# Where the SQLite assessment database lives (default: database/creditsense.db)
# CREDITSENSE_DB_PATH=database/creditsense.db

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
# CREDITSENSE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Optional narrative generation via a LOCAL Ollama server
# ---------------------------------------------------------------------------
# OLLAMA_ENABLED=0
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Optional narrative generation via an OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# Only used when all three values are present. Any key you obtain belongs in
# your own environment or secret store - never in the repository, never in a
# screenshot, and never in a bug report.
# LLM_API_BASE=https://example.invalid/v1
# LLM_API_KEY=
# LLM_MODEL=
